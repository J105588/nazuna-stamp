# Master Secret key for encrypting localStorage/DB data (Keep in env)
VITE_STORAGE_SECRET=your_complex_high_entropy_storage_secret_key_here

# Static Salt for QR synchronization checksum integrity (Keep in env)
VITE_SYNC_SALT=your_complex_high_entropy_sync_salt_key_here

# Supabase DB Configuration (Optional: Required if connecting to remote Supabase DB)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
